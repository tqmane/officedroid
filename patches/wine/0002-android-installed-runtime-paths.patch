From: OfficeDroid contributors
Subject: [PATCH] loader: support APK-installed ELF and private PE/data paths

Applies only when the Android application explicitly supplies both paths.
Unconfigured upstream installations retain their original layout.
License: LGPL-2.1-or-later, like the modified Wine files.

--- a/loader/main.c
+++ b/loader/main.c
@@ -158,7 +158,11 @@
     if ((p = remove_tail( dir, "/loader" )))
         path = build_path( p, "dlls/ntdll/ntdll.so" );
     else
+#ifdef __ANDROID__
+        path = build_path( dir, getenv( "OFFICEDROID_DLL_DIR" ) ? "libntdll.so" : "ntdll.so" );
+#else
         path = build_path( dir, "ntdll.so" );
+#endif
 
     handle = dlopen( path, RTLD_NOW );
     free( p );
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -453,6 +453,17 @@
     if (!dladdr( init_paths, &info ) || !(ntdll_dir = realpath_dirname( info.dli_fname )))
         fatal_error( "cannot get path to ntdll.so\n" );
 
+#ifdef __ANDROID__
+    /* APK-installed Unix code is immutable; PE/data files live in app storage. */
+    if (getenv( "OFFICEDROID_DLL_DIR" ) && getenv( "OFFICEDROID_DATA_DIR" ))
+    {
+        dll_dir = strdup( getenv( "OFFICEDROID_DLL_DIR" ));
+        data_dir = strdup( getenv( "OFFICEDROID_DATA_DIR" ));
+        bin_dir = ntdll_dir;
+        wineloader = build_path( ntdll_dir, "libwine.so" );
+    }
+    else
+#endif
     if ((build_dir = remove_tail( ntdll_dir, "/dlls/ntdll" )))
     {
         wineloader = build_path( build_dir, "loader/wine" );
