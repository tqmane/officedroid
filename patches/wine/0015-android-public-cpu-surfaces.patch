 };
 
 struct ioctl_android_create_window
@@ -1101,6 +1112,68 @@
     return STATUS_SUCCESS;
 }
 
+static NTSTATUS flush_cpu_ioctl( void *data, DWORD in_size, DWORD out_size, ULONG_PTR *ret_size )
+{
+    struct ioctl_android_flush_cpu *req = data;
+    struct native_win_data *win;
+    OBJECT_ATTRIBUTES attr = { .Length = sizeof(attr) };
+    CLIENT_ID cid = { .UniqueProcess = UlongToHandle( current_client_id() ) };
+    HANDLE process, section;
+    ANativeWindow_Buffer buffer;
+    SIZE_T size = 0;
+    void *bits = NULL;
+    NTSTATUS status;
+    int ret, x, y, width, height;
+
+    if (in_size != sizeof(*req) || req->width <= 0 || req->height <= 0 ||
+        (ULONGLONG)req->width * req->height > 64 * 1024 * 1024)
+        return STATUS_INVALID_PARAMETER;
+    if (!(win = get_ioctl_native_win_data( &req->hdr ))) return STATUS_INVALID_HANDLE;
+    if (!win->parent) return STATUS_DEVICE_NOT_READY;
+    if ((status = NtOpenProcess( &process, PROCESS_DUP_HANDLE, &attr, &cid ))) return status;
+    status = NtDuplicateObject( process, UlongToHandle(req->section), GetCurrentProcess(),
+                               &section, SECTION_MAP_READ, 0, 0 );
+    NtClose( process );
+    if (status) return status;
+    status = NtMapViewOfSection( section, GetCurrentProcess(), &bits, 0, 0,
+                                NULL, &size, ViewShare, 0, PAGE_READONLY );
+    NtClose( section );
+    if (status) return status;
+    if (size < (SIZE_T)req->width * req->height * 4)
+    {
+        NtUnmapViewOfSection( GetCurrentProcess(), bits );
+        return STATUS_INVALID_PARAMETER;
+    }
+    wrap_java_call();
+    ret = pANativeWindow_lock( win->parent, &buffer, NULL );
+    if (!ret)
+    {
+        width = min( req->width, min( buffer.width, buffer.stride ) );
+        height = min( req->height, buffer.height );
+        if (buffer.format == PF_BGRA_8888 || buffer.format == PF_RGBA_8888)
+        {
+            for (y = 0; y < height; y++)
+            {
+                const DWORD *src = (const DWORD *)bits + y * req->width;
+                DWORD *dst = (DWORD *)buffer.bits + y * buffer.stride;
+                if (buffer.format == PF_BGRA_8888) memcpy( dst, src, width * 4 );
+                else for (x = 0; x < width; x++)
+                    dst[x] = (src[x] & 0xff00ff00) | ((src[x] & 0xff) << 16) | ((src[x] >> 16) & 0xff);
+            }
+            ret = pANativeWindow_unlockAndPost( win->parent );
+        }
+        else
+        {
+            pANativeWindow_unlockAndPost( win->parent );
+            ret = -EINVAL;
+        }
+    }
+    unwrap_java_call();
+    NtUnmapViewOfSection( GetCurrentProcess(), bits );
+    if (ret) WARN( "CPU surface flush failed %d\n", ret );
+    return android_error_to_status( ret );
+}
+
 typedef NTSTATUS (*ioctl_func)( void *in, DWORD in_size, DWORD out_size, ULONG_PTR *ret_size );
 static const ioctl_func ioctl_funcs[] =
 {
@@ -1116,6 +1189,7 @@
     setSwapInterval_ioctl,      /* IOCTL_SET_SWAP_INT */
     setCapture_ioctl,           /* IOCTL_SET_CAPTURE */
     setCursor_ioctl,            /* IOCTL_SET_CURSOR */
