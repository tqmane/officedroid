 DECL_FUNCPTR( ANativeWindow_fromSurface );
 DECL_FUNCPTR( ANativeWindow_release );
+DECL_FUNCPTR( ANativeWindow_lock );
+DECL_FUNCPTR( ANativeWindow_unlockAndPost );
