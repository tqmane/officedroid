+        if ((ret = query( window, NATIVE_WINDOW_WIDTH, &width ))) return ret;
+        if ((ret = query( window, NATIVE_WINDOW_HEIGHT, &height ))) return ret;
+        if (width <= 0 || height <= 0 || (ULONGLONG)width * height > 64 * 1024 * 1024) return -EINVAL;
+        if (!win->cpu_bits || width != win->cpu_width || height != win->cpu_height)
         {
-            if ((ret = gralloc_lock( buffer, &buffer_ret->bits )))
-            {
-                WARN( "gralloc->lock %p failed %d %s\n", win->hwnd, ret, strerror(-ret) );
-                window->cancelBuffer( window, buffer, -1 );
-            }
+            if (win->cpu_bits) NtUnmapViewOfSection( GetCurrentProcess(), win->cpu_bits );
+            if (win->cpu_section) NtClose( win->cpu_section );
+            win->cpu_bits = NULL;
+            win->cpu_section = NULL;
+            size.QuadPart = (ULONGLONG)width * height * 4;
+            status = NtCreateSection( &win->cpu_section, SECTION_ALL_ACCESS, NULL, &size,
+                                      PAGE_READWRITE, SEC_COMMIT, NULL );
+            if (status) return status_to_android_error( status );
+            status = NtMapViewOfSection( win->cpu_section, GetCurrentProcess(), &win->cpu_bits,
+                                        0, 0, NULL, &count, ViewShare, 0, PAGE_READWRITE );
+            if (status) return status_to_android_error( status );
+            win->cpu_width = width;
+            win->cpu_height = height;
         }
-        if (!ret)
+        buffer->width = buffer->stride = width;
+        buffer->height = height;
+        buffer->format = PF_BGRA_8888;
+        buffer->bits = win->cpu_bits;
+        if (bounds)
         {
-            buffer_ret->width  = buffer->width;
-            buffer_ret->height = buffer->height;
-            buffer_ret->stride = buffer->stride;
-            buffer_ret->format = buffer->format;
-            win->locked_buffer = buffer;
-            if (bounds)
-            {
-                bounds->left   = 0;
-                bounds->top    = 0;
-                bounds->right  = buffer->width;
-                bounds->bottom = buffer->height;
-            }
+            bounds->left = bounds->top = 0;
+            bounds->right = width;
+            bounds->bottom = height;
         }
+        return 0;
+    }
+    case NATIVE_WINDOW_UNLOCK_AND_POST:
+    {
+        struct ioctl_android_flush_cpu req = { { HandleToLong(win->hwnd), win->opengl },
+                                              HandleToUlong(win->cpu_section), win->cpu_width, win->cpu_height };
         va_end( args );
-        TRACE( "hwnd %p %s bits %p ret %d %s\n", win->hwnd, names[operation], buffer_ret->bits, ret, strerror(-ret) );
-        return ret;
-    }
-    case NATIVE_WINDOW_UNLOCK_AND_POST:
-    {
-        int ret = -EINVAL;
-        if (win->locked_buffer)
-        {
-            gralloc_unlock( win->locked_buffer );
-            ret = window->queueBuffer( window, win->locked_buffer, -1 );
-            win->locked_buffer = NULL;
-        }
-        va_end( args );
-        TRACE( "hwnd %p %s ret %d\n", win->hwnd, names[operation], ret );
-        return ret;
+        return android_ioctl( IOCTL_FLUSH_CPU, &req, sizeof(req), NULL, NULL );
     }
     case NATIVE_WINDOW_CONNECT:
     case NATIVE_WINDOW_DISCONNECT:
@@ -1580,6 +1656,8 @@
         if (win->buffers[i]) win->buffers[i]->buffer.common.decRef( &win->buffers[i]->buffer.common );
 
     destroy_ioctl_window( win->hwnd, win->opengl );
+    if (win->cpu_bits) NtUnmapViewOfSection( GetCurrentProcess(), win->cpu_bits );
+    if (win->cpu_section) NtClose( win->cpu_section );
     free( win );
 }
 
